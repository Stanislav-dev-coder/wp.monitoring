          "editorMode": "code",
          "exemplar": false,
          "expr": "sum(\n  rate(node_network_receive_bytes_total{\n    instance=\"$node\",\n    job=\"$job\",\n    device=~\"eth.*|en.*|bond.*\"\n  }[$__rate_interval])\n) * 8",
          "format": "time_series",
          "instant": false,
          "legendFormat": "Принято {{device}}",
          "range": true,
          "refId": "A",
          "step": 240
        },
