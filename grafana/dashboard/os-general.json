          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "editorMode": "code",
          "expr": "sum(\n  rate(node_network_transmit_bytes_total{\n    instance=\"$node\",\n    job=\"$job\",\n    device=~\"eth.*|en.*|bond.*\"\n  }[$__rate_interval])\n) * 8",
          "format": "time_series",
          "interval": "",
          "legendFormat": "Отправлено {{device}} ",
          "range": true,
          "refId": "B",
          "step": 240
